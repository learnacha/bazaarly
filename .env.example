# Copy this file to .env and fill it in. Never commit .env.
# Neon connection string (Neon console > your project > Connect).
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Signs session cookies. At least 32 random characters. Generate one with:
#   node -p "require('crypto').randomBytes(32).toString('base64')"
BETTER_AUTH_SECRET=
# Public address of the app, no trailing slash. Optional locally (defaults to http://localhost:PORT)
# and on Render (RENDER_EXTERNAL_URL is used); required on other hosts, e.g. https://my-app.example.com
# BETTER_AUTH_URL=
PORT=3000

# Optional: send metrics to Grafana Cloud (Connections > OpenTelemetry). Telemetry is off if unset.
# GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# GRAFANA_INSTANCE_ID=
# GRAFANA_API_TOKEN=

# --- Alert -> RCA triage (see triage/) ---
# GRAFANA_URL=https://<stack>.grafana.net
# GRAFANA_ALERTING_TOKEN=      # service account token: alert rules + contact points only
# GRAFANA_READ_TOKEN=          # token with logs:read and metrics:read (used by the RCA agent)
# LOKI_URL=https://logs-prod-XXX.grafana.net      # Connections > Loki > Details
# LOKI_USER=
# PROM_URL=https://prometheus-prod-XX-prod-ap-south-1.grafana.net/api/prom
# PROM_USER=
# TRIAGE_WEBHOOK_SECRET=       # 16+ random chars: node -p "require('crypto').randomBytes(24).toString('hex')"
# TRIAGE_PUBLIC_URL=https://<tunnel-host>/webhook
# TRIAGE_SLACK_CHANNEL=all-sha-orbit
# CHAOS_5XX_RATE=              # test only: 0.6 fails 60% of GET /api/products
